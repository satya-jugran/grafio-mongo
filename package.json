{
  "name": "grafio-mongo",
  "version": "1.1.0",
  "description": "MongoDB storage backend for grafio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:prod": "npm run clean && tsc -p tsconfig.prod.json",
    "clean": "rimraf dist",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text-summary --coverageReporters=html",
    "perf": "ts-node --project tsconfig.perf.json tests/perf/entryPoint.ts",
    "perf:gc": "cross-env TS_NODE_PROJECT=tsconfig.perf.json node --expose-gc -r ts-node/register tests/perf/entryPoint.ts"
  
  },
  "peerDependencies": {
    "grafio": ">=6.2.0",
    "mongodb": ">=5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.6.0",
    "grafio": "^6.2.0",
    "cross-env": "^10.1.0",
    "jest": "^29.5.0",
    "rimraf": "^5.0.0",
    "mongodb": "^7.2.0",
    "mongodb-memory-server": "^11.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "author": "Satya Jugran",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/satya-jugran/grafio-mongo"
  },
  "funding": "https://ko-fi.com/satyajugran"
}