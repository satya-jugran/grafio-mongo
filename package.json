{
  "name": "grafio-mongo",
  "version": "4.1.0",
  "description": "MongoDB storage backend for grafio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:prod": "npm run clean && tsc -p tsconfig.prod.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rimraf dist",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text-summary --coverageReporters=html",
    "perf": "tsx tests/perf/entryPoint.ts",
    "perf:gc": "node --expose-gc --import tsx tests/perf/entryPoint.ts"
  },
  "peerDependencies": {},
  "dependencies": {
    "grafio": "^8.1.0",
    "mongodb": ">=7.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.6.0",
    "jest": "^29.5.0",
    "mongodb-memory-server": "^11.1.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "author": "Satya Jugran",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/satya-jugran/grafio-mongo"
  },
  "funding": "https://ko-fi.com/satyajugran"
}
